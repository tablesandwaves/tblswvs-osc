{
  "compilerOptions": {
    "strict": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "module": "nodenext",
    "target": "esnext",
    "rootDir": "./src",
    "outDir": "./build",
    "moduleResolution": "nodenext",
    "declaration": true,
    "types": ["node"],
  },
  "include": ["./src/**/*"],
  "exclude": [
    "./tests/",
    "./node_modules/",
    "./dist/",
  ],
}
